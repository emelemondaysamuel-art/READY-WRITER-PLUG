<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ready-Writer</title>
<style>
:root{--bg:#141210;--card:#1c1a18;--in:#0f0e0d;--line:#2b2824;--tx:#ece6dc;--mut:#9a948a;--ac:#e07b39}
*{box-sizing:border-box}[hidden]{display:none!important}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.4 system-ui,sans-serif;padding:16px 16px 110px}
main{max-width:720px;margin:0 auto}
h1{font:700 2rem Georgia,serif;letter-spacing:.06em;margin:4px 0}
.sub{color:var(--mut);margin:0 0 16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:18px;margin-bottom:16px}
h2{color:var(--ac);font-size:.95rem;letter-spacing:.12em;margin:0 0 14px}
label{display:block;color:var(--mut);font-size:.95rem;margin:14px 0 6px}
input[type=text],textarea{width:100%;background:var(--in);color:var(--tx);border:1px solid var(--line);border-radius:12px;padding:14px;font:inherit}
input::placeholder,textarea::placeholder{color:#5f5a52}
textarea{min-height:110px;resize:vertical}#text{min-height:220px}
textarea:focus,input:focus{outline:2px solid #fff;border-color:#fff}
.row{display:flex;flex-wrap:wrap;gap:10px;margin:12px 0}
.btn,.chips button{background:var(--in);color:var(--tx);border:1px solid var(--line);border-radius:999px;padding:11px 18px;font:inherit;cursor:pointer}
.chips{display:flex;flex-wrap:wrap;gap:10px}
.chips button.on{background:var(--ac);border-color:var(--ac);color:#fff}
.btn.up{border-color:var(--ac);color:var(--ac)}
.chk{display:flex;gap:12px;align-items:flex-start;color:var(--tx);margin:12px 0;font-size:1rem}
.chk input{width:22px;height:22px;accent-color:#4f8cff;flex:none}
.drop{outline:2px dashed var(--ac)}
#note{color:var(--mut);font-size:.9rem;min-height:1.2em}
#bar{position:fixed;left:0;right:0;bottom:0;padding:14px 16px;background:linear-gradient(transparent,var(--bg) 40%)}
#build{display:block;width:100%;max-width:720px;margin:0 auto;background:var(--ac);color:#fff;border:0;border-radius:14px;padding:18px;font:600 1.05rem inherit;cursor:pointer}
#build:disabled{opacity:.6}
#result a{display:inline-block;background:var(--ac);color:#fff;padding:14px 22px;border-radius:12px;text-decoration:none;font-weight:600;margin-top:8px}
.err{color:#ff8a80}
</style>
</head>
<body>
<main>
<h1>READY-WRITER</h1>
<p class="sub">Paste your manuscript. Get a KDP-ready ebook, formatted, edited and covered.</p>

<section class="card">
  <h2>1 · MANUSCRIPT</h2>
  <label for="title">Book title</label><input type="text" id="title" placeholder="My Book Title">
  <label for="author">Author name</label><input type="text" id="author" placeholder="Your Name">
  <label for="text">Paste your chapters (start each with “Chapter 1”, “Chapter 2”… or “# Title”) or upload files</label>
  <textarea id="text" placeholder="Chapter 1: The Beginning&#10;&#10;Your text here…"></textarea>
  <div class="row">
    <label class="btn up" style="margin:0">Upload .docx / .txt<input type="file" id="file" accept=".docx,.txt,.md" multiple hidden></label>
    <button class="btn" id="sample">Try a sample</button>
    <button class="btn" id="clear">Clear</button>
  </div>
  <div id="note"></div>
  <label class="chk"><input type="checkbox" id="autoedit" checked> Auto-edit (smart quotes, spacing, dashes, duplicate words, line joins)</label>
  <label class="chk"><input type="checkbox" id="copyright" checked> Add a copyright page</label>
  <label class="chk"><input type="checkbox" id="contents" checked> Add a contents page</label>
  <label for="dedication">Dedication (optional)</label><input type="text" id="dedication" placeholder="For my family…">
  <label for="blurb">Back cover blurb (used on the print cover wrap)</label><textarea id="blurb"></textarea>
  <label for="about">About the author (optional)</label><textarea id="about"></textarea>
  <label for="alsoby">Also by (comma-separated titles, optional)</label><input type="text" id="alsoby">
  <label for="series">Series and book number (optional, e.g. The Lantern Saga, Book 1)</label><input type="text" id="series">
  <label for="isbn">ISBN (optional)</label><input type="text" id="isbn" placeholder="978-…">
</section>

<section class="card">
  <h2>2 · FORMAT</h2>
  <label style="margin-top:0">Trim size (print/PDF; the ebook reflows on any device)</label>
  <div class="chips" data-k="trim">
    <button data-v="5x8">5 × 8 in</button><button data-v="5.5x8.5" class="on">5.5 × 8.5 in</button><button data-v="6x9">6 × 9 in</button><button data-v="8.5x11">8.5 × 11 in</button>
  </div>
  <label>Style</label>
  <div class="chips" data-k="style"><button data-v="text" class="on">Text only</button><button data-v="pictures">With pictures</button></div>
  <div id="picrow" hidden>
    <div class="row"><label class="btn up" style="margin:0">Add pictures<input type="file" id="imgs" accept="image/*" multiple hidden></label></div>
    <div id="picnote" style="color:var(--mut);font-size:.9rem">Each picture is inserted at your cursor as [image: name]. Move that line wherever you want it.</div>
  </div>
  <label class="chk"><input type="checkbox" id="print"> Print layout: mirrored margins with a KDP gutter (the PDF then leaves out the cover page)</label>
  <label>Font</label>
  <div class="chips" data-k="font"><button data-v="serif" class="on">Serif</button><button data-v="classic">Classic</button><button data-v="sans">Sans</button></div>
  <label>Premium cover</label>
  <div class="chips" data-k="cover"><button data-v="midnight" class="on">Midnight Gold</button><button data-v="crimson">Crimson</button><button data-v="forest">Forest</button><button data-v="ivory">Ivory</button></div>
</section>

<section class="card" id="result" hidden></section>
</main>
<div id="bar"><button id="build">Build my ebook</button></div>

<script>
const $ = s => document.querySelector(s);
const S = { trim: '5.5x8.5', style: 'text', font: 'serif', cover: 'midnight' };
const IMGS = {};
const FIELDS = ['title','author','text','dedication','blurb','about','alsoby','series','isbn'];
const CHECKS = ['autoedit','copyright','contents','print'];
const note = t => $('#note').textContent = t;

// ---- autosave (text only, not images) ----
function save() {
  try { localStorage.setItem('rw', JSON.stringify({ S, f: Object.fromEntries(FIELDS.map(k => [k, $('#' + k).value])), c: Object.fromEntries(CHECKS.map(k => [k, $('#' + k).checked])) })); } catch (e) {}
}
function load() {
  try {
    const d = JSON.parse(localStorage.getItem('rw') || 'null'); if (!d) return;
    FIELDS.forEach(k => $('#' + k).value = d.f[k] || ''); CHECKS.forEach(k => $('#' + k).checked = !!d.c[k]);
    Object.assign(S, d.S);
    document.querySelectorAll('.chips').forEach(g => g.querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.v === S[g.dataset.k])));
    $('#picrow').hidden = S.style !== 'pictures';
  } catch (e) {}
}
document.addEventListener('input', save);

// ---- chips ----
document.querySelectorAll('.chips').forEach(g => g.onclick = e => {
  const b = e.target.closest('button'); if (!b) return;
  g.querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b));
  S[g.dataset.k] = b.dataset.v;
  if (g.dataset.k === 'style') $('#picrow').hidden = b.dataset.v !== 'pictures';
  save();
});

// ---- upload .docx / .txt ----
async function addFiles(files) {
  for (const f of files) {
    note('Reading ' + f.name + '…');
    const fd = new FormData(); fd.append('file', f);
    try {
      const r = await fetch('/api/extract', { method: 'POST', body: fd });
      const j = await r.json(); if (!r.ok) throw new Error(j.error);
      const t = $('#text'); t.value = (t.value.trim() ? t.value.trim() + '\n\n' : '') + j.text;
      Object.assign(IMGS, j.images || {});
      const n = Object.keys(j.images || {}).length;
      note('Added ' + f.name + (n ? ` · ${n} picture(s) found. Choose “With pictures” to include them.` : ''));
      save();
    } catch (e) { note('⚠ ' + f.name + ': ' + e.message); }
  }
}
$('#file').onchange = e => { addFiles([...e.target.files]); e.target.value = ''; };
const ta = $('#text');
ta.ondragover = e => { e.preventDefault(); ta.classList.add('drop'); };
ta.ondragleave = () => ta.classList.remove('drop');
ta.ondrop = e => { e.preventDefault(); ta.classList.remove('drop'); addFiles([...e.dataTransfer.files]); };

// ---- pictures ----
$('#imgs').onchange = e => {
  [...e.target.files].forEach(f => {
    const rd = new FileReader();
    rd.onload = () => {
      let name = f.name.replace(/[^\w.-]/g, '_'); while (IMGS[name]) name = '_' + name;
      IMGS[name] = rd.result;
      const p = ta.selectionStart ?? ta.value.length;
      ta.value = ta.value.slice(0, p) + `\n\n[image: ${name}]\n\n` + ta.value.slice(p);
      $('#picnote').textContent = Object.keys(IMGS).length + ' picture(s) ready.'; save();
    };
    rd.readAsDataURL(f);
  });
  e.target.value = '';
};

// ---- sample / clear ----
$('#sample').onclick = () => {
  $('#title').value = 'The Lantern Road'; $('#author').value = 'A. Writer';
  ta.value = 'Chapter 1: The Beginning\n\n"It was a dark night," she said -- and the lantern flickered...\n\nShe walked on the the road alone.\n\n* * *\n\nBy morning the village was quiet.\n\nChapter 2: The Road\n\nThe road went on and on. He didn\'t look back.';
  save();
};
$('#clear').onclick = () => { ta.value = ''; Object.keys(IMGS).forEach(k => delete IMGS[k]); note(''); save(); };

// ---- build ----
$('#build').onclick = async () => {
  const btn = $('#build'), res = $('#result');
  const body = { ...S, images: IMGS };
  FIELDS.forEach(k => body[k] = $('#' + k).value); CHECKS.forEach(k => body[k] = $('#' + k).checked);
  btn.disabled = true; btn.textContent = 'Building… this can take a minute';
  res.hidden = true;
  try {
    const r = await fetch('/api/build', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    if (!r.ok) throw new Error((await r.json()).error || 'Build failed');
    const st = JSON.parse(r.headers.get('X-Build-Stats') || '{}');
    const url = URL.createObjectURL(await r.blob());
    const cd = r.headers.get('Content-Disposition') || '';
    const fn = (cd.match(/filename="(.+?)"/) || [])[1] || 'ready-writer-kdp.zip';
    res.innerHTML = `<h2>DONE</h2><p>${st.chapters} chapters · ${st.words} words · ${st.pages} PDF pages</p>
      <p style="color:var(--mut)">The zip holds your EPUB, interior PDF, ebook cover (JPG) and print cover wrap (PDF).</p>
      <a href="${url}" download="${fn}">Download ${fn}</a>`;
    res.hidden = false; res.scrollIntoView({ behavior: 'smooth' });
  } catch (e) {
    res.innerHTML = `<h2>PROBLEM</h2><p class="err">${e.message}</p>`; res.hidden = false;
  }
  btn.disabled = false; btn.textContent = 'Build my ebook';
};
load();
</script>
</body>
</html>
